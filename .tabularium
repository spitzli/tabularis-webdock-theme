{
  "$schema": "https://registry.tabularis.dev/manifest.schema.json?kind=theme",
  "name": "Webdock for Tabularis",
  "version": "1.0.0",
  "kind": "theme",
  "min_runtime_version": "0.26.0",
  "theme_schema_version": 1,
  "theme_variants": [
    {
      "id": "light",
      "name": "Webdock Light",
      "file": "themes/light.json"
    },
    {
      "id": "dark",
      "name": "Webdock Dark",
      "file": "themes/dark.json"
    }
  ],
  "id": "webdock-theme",
  "description": "The Webdock Console aesthetic for Tabularis: crisp white and true black surfaces, precise neutral borders and signature orange accents. Includes matching SQL editor colors.",
  "license": "MIT",
  "tags": [
    "theme",
    "webdock",
    "orange",
    "minimal",
    "light",
    "dark"
  ],
  "readme": "README.md",
  "homepage": "https://github.com/Spitzli/tabularis-webdock-theme",
  "support": {
    "issues_url": "https://github.com/Spitzli/tabularis-webdock-theme/issues"
  },
  "screenshots": [
    {
      "url": "https://raw.githubusercontent.com/Spitzli/tabularis-webdock-theme/main/screenshots/webdock-light.png",
      "alt": "Webdock Light in Tabularis Web with SQL editor and synthetic project data",
      "caption": "Webdock Light \u2014 SQL workspace"
    },
    {
      "url": "https://raw.githubusercontent.com/Spitzli/tabularis-webdock-theme/main/screenshots/webdock-dark.png",
      "alt": "Webdock Dark in Tabularis Web with SQL editor and synthetic project data",
      "caption": "Webdock Dark \u2014 SQL workspace"
    }
  ]
}
